# ---------------------------------------------------------------------------
# AdCamouflage configuration. Copy to `.env` and adjust.
# Every backend variable is prefixed with ADCAM_.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
ADCAM_ENVIRONMENT=development
ADCAM_DEBUG=false

# --- storage ---------------------------------------------------------------
# Uploads, renders and zip bundles live here. Must be writable by the API and
# by every Celery worker (a shared volume when they run on separate hosts).
ADCAM_STORAGE_ROOT=./storage
ADCAM_RETENTION_HOURS=24
ADCAM_MAX_UPLOAD_MB=2048
ADCAM_MAX_BATCH_FILES=25

# --- redis / celery --------------------------------------------------------
ADCAM_REDIS_URL=redis://localhost:6379/0
# ADCAM_CELERY_BROKER_URL=redis://localhost:6379/1
# ADCAM_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Set to true to run renders on a local thread pool instead of Celery.
# Handy for development; use Celery in production.
ADCAM_INLINE_WORKER=false
ADCAM_INLINE_WORKER_CONCURRENCY=2

# --- security --------------------------------------------------------------
# REQUIRED in production: signs download tokens. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset every process invents its own key and download links break
# as soon as you run more than one API replica.
ADCAM_SECRET_KEY=change-me-in-production
ADCAM_DOWNLOAD_TOKEN_TTL=3600
# Optional: when set, every mutating endpoint requires an X-API-Key header.
# ADCAM_API_KEY=
ADCAM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- media engine ----------------------------------------------------------
ADCAM_FFMPEG_BINARY=ffmpeg
ADCAM_FFPROBE_BINARY=ffprobe
ADCAM_FFMPEG_THREADS=0
ADCAM_JOB_TIMEOUT_SECONDS=2700
ADCAM_VIDEO_MAX_DURATION=1800

# --- frontend --------------------------------------------------------------
# Base URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
